{
	"name": "link-shift",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright install && playwright test",
		"test": "npm run test:e2e",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/db-migrate.js",
		"db:mark-baseline": "node scripts/db-mark-baseline.js",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"db:seed": "tsx src/lib/server/db/seed.ts",
		"db:smoke:campaign": "tsx scripts/db-smoke-campaign.ts",
		"db:smoke:redirect": "tsx scripts/db-smoke-redirect.ts",
		"test:redirect": "tsx scripts/test-redirect-engine.ts"
	},
