# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Optional Upstash cache and distributed rate limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
REDIRECT_CACHE_TTL_SECONDS="30"
REDIRECT_RATE_LIMIT="120"
REDIRECT_RATE_WINDOW_SECONDS="60"
SLOW_REDIRECT_THRESHOLD_MS="500"

# Analytics retention (run `pnpm db:cleanup:analytics` first, then add `-- --execute`)
CLICK_EVENT_RETENTION_DAYS="180"
EMBED_EVENT_RETENTION_DAYS="180"
VISITOR_RETENTION_DAYS="365"
AUDIT_LOG_RETENTION_DAYS="365"
ANALYTICS_CLEANUP_BATCH_SIZE="1000"
